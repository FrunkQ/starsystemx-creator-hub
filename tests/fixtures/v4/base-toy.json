{
 "format": "sse.pack/1",
 "id": "sse.base-toy",
 "version": "0.1.0",
 "kind": [
  "base-physics"
 ],
 "kernel_range": "^0.1",
 "licence": "Apache-2.0",
 "provides": {
  "quantity_kinds": [
   {
    "id": "star.mass",
    "dim": [
     0,
     1,
     0,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "star.luminosity",
    "dim": [
     2,
     1,
     -3,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "star.radius",
    "dim": [
     1,
     0,
     0,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "star.effective_temperature",
    "dim": [
     0,
     0,
     0,
     0,
     1,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "orbit.semi_major_axis",
    "dim": [
     1,
     0,
     0,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "orbit.period",
    "dim": [
     0,
     0,
     1,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.insolation",
    "dim": [
     0,
     1,
     -3,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.bond_albedo",
    "dim": [
     0,
     0,
     0,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.equilibrium_temperature",
    "dim": [
     0,
     0,
     0,
     0,
     1,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.surface_temperature",
    "dim": [
     0,
     0,
     0,
     0,
     1,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.mass",
    "dim": [
     0,
     1,
     0,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.radius",
    "dim": [
     1,
     0,
     0,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.surface_gravity",
    "dim": [
     1,
     0,
     -2,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.escape_velocity",
    "dim": [
     1,
     0,
     -1,
     0,
     0,
     0,
     0
    ],
    "description": ""
   },
   {
    "id": "planet.bulk_density",
    "dim": [
     -3,
     1,
     0,
     0,
     0,
     0,
     0
    ],
    "description": ""
   }
  ],
  "flows": [
   {
    "format": "sse.flow/1",
    "id": "toy.star-and-planet",
    "version": "0.1.0",
    "hook": "system.toy",
    "inputs": [
     {
      "name": "star_mass",
      "kind": "star.mass"
     },
     {
      "name": "distance",
      "kind": "orbit.semi_major_axis"
     },
     {
      "name": "albedo",
      "kind": "planet.bond_albedo"
     },
     {
      "name": "planet_mass",
      "kind": "planet.mass"
     },
     {
      "name": "planet_radius",
      "kind": "planet.radius"
     }
    ],
    "nodes": [
     {
      "id": "lum",
      "atom": "toy.luminosity_from_mass",
      "params": {
       "exponent": 3.5
      }
     },
     {
      "id": "rad",
      "atom": "toy.radius_from_mass"
     },
     {
      "id": "teff",
      "atom": "toy.effective_temperature"
     },
     {
      "id": "sun",
      "atom": "toy.insolation"
     },
     {
      "id": "teq",
      "atom": "toy.equilibrium_temperature"
     },
     {
      "id": "year",
      "atom": "toy.orbital_period"
     },
     {
      "id": "grav",
      "atom": "toy.surface_gravity"
     },
     {
      "id": "esc",
      "atom": "toy.escape_velocity"
     },
     {
      "id": "dens",
      "atom": "toy.bulk_density"
     },
     {
      "id": "surf",
      "solve": {
       "atom": "toy.greenhouse_residual",
       "unknown": "t_surface",
       "bracket": [
        1.0,
        100000.0
       ],
       "iterations": 80
      },
      "params": {
       "tau": 0.8
      }
     }
    ],
    "wires": [
     {
      "from": "in.star_mass",
      "to": "lum.mass"
     },
     {
      "from": "in.star_mass",
      "to": "rad.mass"
     },
     {
      "from": "lum.luminosity",
      "to": "teff.luminosity"
     },
     {
      "from": "rad.radius",
      "to": "teff.radius"
     },
     {
      "from": "lum.luminosity",
      "to": "sun.luminosity"
     },
     {
      "from": "in.distance",
      "to": "sun.distance"
     },
     {
      "from": "sun.flux",
      "to": "teq.flux"
     },
     {
      "from": "in.albedo",
      "to": "teq.albedo"
     },
     {
      "from": "in.distance",
      "to": "year.distance"
     },
     {
      "from": "in.star_mass",
      "to": "year.mass"
     },
     {
      "from": "in.planet_mass",
      "to": "grav.mass"
     },
     {
      "from": "in.planet_radius",
      "to": "grav.radius"
     },
     {
      "from": "in.planet_mass",
      "to": "esc.mass"
     },
     {
      "from": "in.planet_radius",
      "to": "esc.radius"
     },
     {
      "from": "in.planet_mass",
      "to": "dens.mass"
     },
     {
      "from": "in.planet_radius",
      "to": "dens.radius"
     },
     {
      "from": "sun.flux",
      "to": "surf.flux"
     },
     {
      "from": "in.albedo",
      "to": "surf.albedo"
     }
    ],
    "publishes": [
     {
      "kind": "star.luminosity",
      "from": "lum.luminosity"
     },
     {
      "kind": "star.radius",
      "from": "rad.radius"
     },
     {
      "kind": "star.effective_temperature",
      "from": "teff.teff"
     },
     {
      "kind": "planet.insolation",
      "from": "sun.flux"
     },
     {
      "kind": "planet.equilibrium_temperature",
      "from": "teq.teq"
     },
     {
      "kind": "orbit.period",
      "from": "year.period"
     },
     {
      "kind": "planet.surface_gravity",
      "from": "grav.g"
     },
     {
      "kind": "planet.escape_velocity",
      "from": "esc.v"
     },
     {
      "kind": "planet.bulk_density",
      "from": "dens.density"
     },
     {
      "kind": "planet.surface_temperature",
      "from": "surf.t_surface"
     }
    ],
    "tests": [
     {
      "name": "sun and earth",
      "inputs": {
       "star_mass": {
        "value": 1.0,
        "unit": "m_sun"
       },
       "distance": {
        "value": 1.0,
        "unit": "au"
       },
       "albedo": 0.3,
       "planet_mass": {
        "value": 1.0,
        "unit": "m_earth"
       },
       "planet_radius": {
        "value": 1.0,
        "unit": "r_earth"
       }
      },
      "expect": {
       "star.effective_temperature": {
        "value": 5772,
        "unit": "k",
        "tol": 1
       },
       "planet.insolation": {
        "value": 1361,
        "unit": "w_m2",
        "tol": 1
       },
       "planet.equilibrium_temperature": {
        "value": 254.6,
        "unit": "k",
        "tol": 0.3
       },
       "planet.surface_temperature": {
        "value": 286.3,
        "unit": "k",
        "tol": 0.5
       },
       "orbit.period": {
        "value": 365.256,
        "unit": "day",
        "tol": 0.01
       },
       "planet.surface_gravity": {
        "value": 9.798,
        "unit": "m_s2",
        "tol": 0.01
       },
       "planet.escape_velocity": {
        "value": 11.18,
        "unit": "km_s",
        "tol": 0.01
       },
       "planet.bulk_density": {
        "value": 5.495,
        "unit": "g_cm3",
        "tol": 0.005
       }
      }
     }
    ]
   }
  ]
 }
}